# Copy to .env (git-ignored) and fill in. Never commit real values.

# Neon connection string. Local dev/testing = the Neon "dev" branch ONLY.
# In production set this in Netlify > Site settings > Environment variables.
DATABASE_URL=

# Used only by `npm run seed` to set the PIN for the Deno tenant on first creation.
# 6-8 digits. Remove it from .env after seeding.
DENO_PIN=
